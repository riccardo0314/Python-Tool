# Copy this file to .env and fill in your real API key.
# .env is gitignored and will never be committed.

VT_API_KEY=your_virustotal_api_key_here

# --- AI correlation layer (two-model debate) ---
# provider: "anthropic" or "openai_compatible"
# "openai_compatible" also works with local models served via an
# OpenAI-style API, e.g. Ollama (base_url = http://localhost:11434/v1,
# api_key can be left empty).

MODEL_1_PROVIDER=anthropic
MODEL_1_NAME=claude-sonnet-4-5
MODEL_1_API_KEY=your_anthropic_api_key_here
MODEL_1_BASE_URL=

MODEL_2_PROVIDER=openai_compatible
MODEL_2_NAME=gpt-4o-mini
MODEL_2_API_KEY=your_openai_api_key_here
MODEL_2_BASE_URL=

# Example for a local model instead of model 2 above:
# MODEL_2_PROVIDER=openai_compatible
# MODEL_2_NAME=llama3
# MODEL_2_API_KEY=
# MODEL_2_BASE_URL=http://localhost:11434/v1
